@page "/components/known-date"

<PageTitle>Known Date</PageTitle>

<h1>Known Date <ComponentBadges Tag="wa-known-date" /></h1>
<p>Known Date collects a date the user already knows — a birthday, a document date — through separate day, month, and year fields. <code>WaKnownDate</code> binds a <code>DateOnly?</code>, converted culture-free from the element's canonical ISO date (<code>YYYY-MM-DD</code>); a partly filled date binds as null. <code>&lt;wa-known-date&gt;</code> wrapped by <code>WaKnownDate</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaKnownDate Label="When was your passport issued?" @bind-Value="defaultValue" />
    <p>Value: <code>@(defaultValue is null ? "(empty)" : DemoFormat.Iso(defaultValue))</code></p>
</ExampleSection>

<ExampleSection Title="Initial Value &amp; Hint" Code="@ValueExample">
    <WaKnownDate Label="Date of birth" Hint="We use this to verify your age." @bind-Value="dobValue" />
</ExampleSection>

<ExampleSection Title="Min, Max &amp; Locale" Code="@ConstraintsExample">
    <WaKnownDate Label="Issue date" Locale="en-GB" Min="EarliestIssue" Max="LatestIssue" @bind-Value="issueValue" />
</ExampleSection>

<ExampleSection Title="Appearance &amp; Pill" Code="@AppearanceExample">
    <WaKnownDate Label="Filled" Appearance="WaInputAppearance.Filled" @bind-Value="filledValue" />
    <WaKnownDate Label="Pill" Pill="true" @bind-Value="pillValue" />
</ExampleSection>

<ApiTable Tag="wa-known-date" />

@code {
    private static readonly DateOnly EarliestIssue = new(1900, 1, 1);
    private static readonly DateOnly LatestIssue = new(2026, 12, 31);

    private DateOnly? defaultValue;
    private DateOnly? dobValue = new(1990, 5, 25);
    private DateOnly? issueValue;
    private DateOnly? filledValue;
    private DateOnly? pillValue;

    private const string DefaultExample = """
        <WaKnownDate Label="When was your passport issued?" @bind-Value="defaultValue" />

        @code {
            private DateOnly? defaultValue;
        }
        """;

    private const string ValueExample = """
        <WaKnownDate Label="Date of birth" Hint="We use this to verify your age." @bind-Value="dobValue" />

        @code {
            private DateOnly? dobValue = new(1990, 5, 25);
        }
        """;

    private const string ConstraintsExample = """
        <WaKnownDate Label="Issue date" Locale="en-GB" Min="EarliestIssue" Max="LatestIssue" @bind-Value="issueValue" />

        @code {
            private static readonly DateOnly EarliestIssue = new(1900, 1, 1);
            private static readonly DateOnly LatestIssue = new(2026, 12, 31);
            private DateOnly? issueValue;
        }
        """;

    private const string AppearanceExample = """
        <WaKnownDate Label="Filled" Appearance="WaInputAppearance.Filled" @bind-Value="filledValue" />
        <WaKnownDate Label="Pill" Pill="true" @bind-Value="pillValue" />

        @code {
            private DateOnly? filledValue;
            private DateOnly? pillValue;
        }
        """;
}
