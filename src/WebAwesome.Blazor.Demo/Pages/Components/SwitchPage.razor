@page "/components/switch"

<PageTitle>Switch</PageTitle>

<h1>Switch <ComponentBadges Tag="wa-switch" /></h1>
<p>Switches toggle a setting on or off. <code>&lt;wa-switch&gt;</code> wrapped by <code>WaSwitch</code>; its label is the content.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaSwitch @bind-Value="value">Switch</WaSwitch>
</ExampleSection>

<ExampleSection Title="Two-way Binding" Code="@BindingExample">
    <WaSwitch @bind-Value="notifications" OnCheckedChange="@(isChecked => checkedChanges++)">Notifications</WaSwitch>
    <p>Notifications: <strong>@notifications</strong></p>
    <p>OnCheckedChange calls: <strong>@checkedChanges</strong></p>
</ExampleSection>

<ExampleSection Title="Checked" Code="@CheckedExample">
    <WaStack Gap="GapSize.Gap_S">
        <WaSwitch @bind-Value="autoSave">Auto-save</WaSwitch>
        <WaSwitch @bind-Value="betaFeatures">Beta features</WaSwitch>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Hint" Code="@HintExample">
    <WaStack Gap="GapSize.Gap_M">
        <WaSwitch Hint="Sends a weekly summary every Monday." @bind-Value="digest">Weekly digest</WaSwitch>
        <WaSwitch @bind-Value="twoFactor">
            <ChildContent>Two-factor sign-in</ChildContent>
            <MarkupHint>Requires the <strong>Authenticator</strong> app.</MarkupHint>
        </WaSwitch>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Sizes" Code="@SizesExample">
    <WaStack Gap="GapSize.Gap_S">
        <WaSwitch Size="WaSize.Small" @bind-Value="small">Small</WaSwitch>
        <WaSwitch Size="WaSize.Medium" @bind-Value="medium">Medium</WaSwitch>
        <WaSwitch Size="WaSize.Large" @bind-Value="large">Large</WaSwitch>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Disabled" Code="@DisabledExample">
    <WaStack Gap="GapSize.Gap_S">
        <WaSwitch Disabled="true" @bind-Value="lockedOn">Managed by your organization</WaSwitch>
        <WaSwitch Disabled="false" @bind-Value="unlocked">Yours to change</WaSwitch>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Required in a Form" Code="@RequiredExample">
    <EditForm Model="terms" OnValidSubmit="() => submitted = true">
        <WaStack Gap="GapSize.Gap_M">
            <WaSwitch Required="true" @bind-Value="terms.Accepted">I accept the terms</WaSwitch>
            <WaButton Type="WaButtonType.Submit" Variant="WaVariant.Brand" Style="align-self: start;">Continue</WaButton>
        </WaStack>
    </EditForm>
    @if (submitted)
    {
        <p>Submitted.</p>
    }
</ExampleSection>

