@page "/components/stepper"

<PageTitle>Stepper</PageTitle>

<h1>Stepper <ComponentBadges Tag="wa-stepper" /></h1>
<p>
    Steppers show where the user is in a multi-step process, such as a checkout or a setup wizard.
    <code>&lt;wa-stepper&gt;</code> wrapped by <code>WaStepper</code>, with <code>&lt;wa-step&gt;</code> wrapped by
    <a href="components/step"><code>WaStepperStep</code></a>. <code>Active</code> names the current step; a stepper is a display, not a form control,
    so pair it with your own buttons calling <code>NextAsync</code>/<code>PreviousAsync</code>/<code>GoToAsync</code>,
    or make it <code>Clickable</code>.
</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaStepper Active="shipping">
        <WaStepperStep Name="cart" Completed="true">Cart</WaStepperStep>
        <WaStepperStep Name="shipping">Shipping</WaStepperStep>
        <WaStepperStep Name="payment">Payment</WaStepperStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Completed &amp; Flagged Steps" Code="@FlaggedExample">
    <WaStepper Active="payment">
        <WaStepperStep Name="cart" Completed="true" Variant="WaVariant.Success">Cart</WaStepperStep>
        <WaStepperStep Name="shipping" Completed="true" Variant="WaVariant.Success">Shipping</WaStepperStep>
        <WaStepperStep Name="payment" Variant="WaVariant.Danger" IconName="xmark">
            <ChildContent>Payment</ChildContent>
            <DescriptionContent>Card declined</DescriptionContent>
        </WaStepperStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Clickable" Code="@ClickableExample">
    <WaStepper Active="shipping" Clickable="true">
        <WaStepperStep Name="cart" Completed="true">Cart</WaStepperStep>
        <WaStepperStep Name="shipping">Shipping</WaStepperStep>
        <WaStepperStep Name="payment">Payment</WaStepperStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Linear" Code="@LinearExample">
    <WaStepper Active="shipping" Linear="true" Clickable="true">
        <WaStepperStep Name="cart" Completed="true">Cart</WaStepperStep>
        <WaStepperStep Name="shipping">Shipping</WaStepperStep>
        <WaStepperStep Name="payment">Payment</WaStepperStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Orientation" Code="@OrientationExample">
    <WaStack Gap="GapSize.Gap_XL">
        <WaStepper Orientation="WaStepperOrientation.Vertical" Active="proof" Style="--gap: var(--wa-space-3xl);">
            <WaStepperStep Name="mix" Completed="true">Mix</WaStepperStep>
            <WaStepperStep Name="knead" Completed="true">Knead</WaStepperStep>
            <WaStepperStep Name="proof">
                <ChildContent>Proof</ChildContent>
                <DescriptionContent>Let it rise. Resist poking it.</DescriptionContent>
            </WaStepperStep>
            <WaStepperStep Name="bake">Bake</WaStepperStep>
        </WaStepper>
        <WaStepper Orientation="WaStepperOrientation.Auto" Active="team">
            <WaStepperStep Name="account" Completed="true">Account</WaStepperStep>
            <WaStepperStep Name="profile" Completed="true">Profile</WaStepperStep>
            <WaStepperStep Name="team">Team</WaStepperStep>
            <WaStepperStep Name="notifications">Notifications</WaStepperStep>
        </WaStepper>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Navigating with Your Own Buttons" Code="@NavigatingExample">
    <WaStack Gap="GapSize.Gap_M">
        <WaStepper @ref="navigationStepper" Label="Checkout" Active="cart" OnStepChange="e => navigationStep = e.Name">
            <WaStepperStep Name="cart" Completed="true">Cart</WaStepperStep>
            <WaStepperStep Name="shipping">Shipping</WaStepperStep>
            <WaStepperStep Name="payment">Payment</WaStepperStep>
        </WaStepper>
        @if (navigationStep == "cart")
        {
            <p>Review the items in your cart.</p>
        }
        else if (navigationStep == "shipping")
        {
            <p>Enter the address to ship to.</p>
        }
        else
        {
            <p>Add a card to pay with.</p>
        }
        <WaDivider />
        <WaCluster Gap="GapSize.Gap_S">
            <WaButton Appearance="WaAppearance.Filled" OnClick="() => navigationStepper!.PreviousAsync()">Back</WaButton>
            <WaButton Appearance="WaAppearance.Filled" OnClick="() => navigationStepper!.NextAsync()">Continue</WaButton>
            <WaButton Appearance="WaAppearance.Filled" OnClick="@(() => navigationStepper!.GoToAsync("payment"))">Skip to Payment</WaButton>
        </WaCluster>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Reacting to Step Changes" Code="@StepChangeExample">
    <p>
        <code>OnStepChange</code> reports the new and the previous step's name. The stepper never marks a step completed
        itself, so this example does it from the handler: the step left behind is done, a step revisited is in progress
        again. <code>OnBeforeStepChange</code> reports the same names before the change, but only as a notification:
        a .NET handler cannot cancel the change (see its remarks), so gate progress with <code>Linear</code> and
        <code>Completed</code> instead.
    </p>
    <WaStack Gap="GapSize.Gap_M">
        <WaStepper @ref="eventsStepper" Label="Order" Active="@eventsStep" OnStepChange="StepChanged">
            @foreach (var step in EventSteps)
            {
                <WaStepperStep @key="step" Name="@step" Completed="@completedSteps.Contains(step)">@step</WaStepperStep>
            }
        </WaStepper>
        <WaDivider />
        <WaCluster Gap="GapSize.Gap_S" AlignItems="AlignItems.Center">
            <WaButton Appearance="WaAppearance.Filled" OnClick="() => eventsStepper!.PreviousAsync()">Back</WaButton>
            <WaButton Appearance="WaAppearance.Filled" OnClick="() => eventsStepper!.NextAsync()">Continue</WaButton>
            <small>Active step: <code>@eventsStep</code> (previous: <code>@(previousEventsStep ?? "none")</code>)</small>
        </WaCluster>
    </WaStack>
</ExampleSection>

<ApiTable Tag="wa-stepper" />

@code {
    private static readonly string[] EventSteps = ["cart", "shipping", "payment"];

    private WaStepper? navigationStepper;
    private string navigationStep = "cart";

    private WaStepper? eventsStepper;
    private string eventsStep = "cart";
    private string? previousEventsStep;
    private readonly HashSet<string> completedSteps = ["cart"];

    // advancing completes the step left behind; going back reopens the step revisited
    private void StepChanged(WaStepChangeEventArgs e)
    {
        var index = Array.IndexOf(EventSteps, e.Name);
        var previousIndex = e.PreviousName is null ? -1 : Array.IndexOf(EventSteps, e.PreviousName);
        if (previousIndex >= 0 && index > previousIndex) completedSteps.Add(e.PreviousName!);
        else completedSteps.Remove(e.Name);

        eventsStep = e.Name;
        previousEventsStep = e.PreviousName;
    }

    private const string DefaultExample = """
        <WaStepper Active="shipping">
            <WaStepperStep Name="cart" Completed="true">Cart</WaStepperStep>
            <WaStepperStep Name="shipping">Shipping</WaStepperStep>
            <WaStepperStep Name="payment">Payment</WaStepperStep>
        </WaStepper>
        """;

    private const string FlaggedExample = """
