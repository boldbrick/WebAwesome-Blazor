@page "/components/icon"
@using WebAwesome.Blazor.Models
@using WebAwesome.Blazor.Services
@inject WaIconLibraryService IconLibraries

<PageTitle>Icon</PageTitle>

<h1>Icon</h1>
<p><code>&lt;wa-icon&gt;</code> wrapped by <code>WaIcon</code>. Web Awesome comes bundled with over 2,000 free icons courtesy of Font Awesome, available in the <code>default</code> icon library.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaIcon Name="face-awesome" Variant="light" Label="Awesome" Style="font-size: 2em;" />
</ExampleSection>

<ExampleSection Title="Families &amp; Variants" Code="@FamiliesAndVariantsExample">
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Name="eyedropper" />
        <WaIcon Variant="regular" Name="grip-vertical" />
        <WaIcon Variant="light" Name="play" />
        <WaIcon Variant="thin" Name="star" />
    </div>
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Family="duotone" Name="eyedropper" />
        <WaIcon Family="duotone" Variant="regular" Name="grip-vertical" />
        <WaIcon Family="duotone" Variant="light" Name="play" />
        <WaIcon Family="duotone" Variant="thin" Name="star" />
    </div>
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Family="brands" Name="font-awesome" />
        <WaIcon Family="brands" Name="web-awesome" />
        <WaIcon Family="brands" Name="github" />
        <WaIcon Family="brands" Name="discord" />
    </div>
</ExampleSection>

<ExampleSection Title="Labels" Code="@LabelsExample">
    <WaIcon Name="star" Label="Favorite" Style="font-size: 1.5em;" />
</ExampleSection>

<ExampleSection Title="Sizing &amp; Color" Code="@SizingAndColorExample">
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Name="strawberry" Style="color: salmon;" />
        <WaIcon Name="crab" Style="color: coral;" />
        <WaIcon Name="sun" Style="color: gold;" />
        <WaIcon Name="leaf" Style="color: mediumseagreen;" />
        <WaIcon Name="cloud-showers-heavy" Style="color: steelblue;" />
        <WaIcon Name="cat-space" Style="color: mediumpurple;" />
    </div>
</ExampleSection>

<ExampleSection Title="Auto Width &amp; Duotone Opacity" Code="@AutoWidthAndOpacityExample">
    <p>Without <code>AutoWidth</code>:</p>
    <div style="font-size: 1.5em; color: #193154;">
        <WaIcon Family="solid" Name="exclamation" Style="background: lightsalmon;" />
        <WaIcon Family="solid" Name="circle-check" Style="background: lightsalmon;" />
        <WaIcon Family="solid" Name="ruler-vertical" Style="background: lightsalmon;" />
    </div>
    <p>With <code>AutoWidth</code>:</p>
    <div style="font-size: 1.5em; color: #193154;">
        <WaIcon AutoWidth="true" Family="solid" Name="exclamation" Style="background: lightsalmon;" />
        <WaIcon AutoWidth="true" Family="solid" Name="circle-check" Style="background: lightsalmon;" />
        <WaIcon AutoWidth="true" Family="solid" Name="ruler-vertical" Style="background: lightsalmon;" />
    </div>
    <p>Duotone with <code>SwapOpacity</code>:</p>
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Family="duotone" Name="home" />
        <WaIcon Family="duotone" Name="home" SwapOpacity="true" />
        <WaIcon Family="duotone" Name="envelope" />
        <WaIcon Family="duotone" Name="envelope" SwapOpacity="true" />
    </div>
</ExampleSection>

<ExampleSection Title="Canvas" Code="@CanvasExample">
    <p>The <code>Canvas</code> box the icon is centered within. Unset renders as fixed (1.25em × 1em); <code>Auto</code> hugs the icon's width, <code>Square</code> is 1.25em × 1.25em, <code>Roomy</code> is 1.5em × 1.5em.</p>
    <div class="wa-cluster" style="font-size: 1.5em; color: #193154;">
        <WaIcon Canvas="WaIconCanvas.Fixed" Family="solid" Name="exclamation" Style="background: lightsalmon;" />
        <WaIcon Canvas="WaIconCanvas.Auto" Family="solid" Name="exclamation" Style="background: lightsalmon;" />
        <WaIcon Canvas="WaIconCanvas.Square" Family="solid" Name="exclamation" Style="background: lightsalmon;" />
        <WaIcon Canvas="WaIconCanvas.Roomy" Family="solid" Name="exclamation" Style="background: lightsalmon;" />
    </div>
</ExampleSection>

<ExampleSection Title="Icon Libraries" Code="@IconLibrariesExample">
    <p>Register libraries at runtime with <code>WaIconLibraryService</code>. The icons below reference their library before it exists and draw as soon as it's registered. A custom library takes a URL template with <code>{name}</code>, <code>{family}</code> and <code>{variant}</code> placeholders, and optionally the name of a global JavaScript mutator function.</p>
    <WaCluster Gap="GapSize.Gap_S">
        <WaButton Size="WaSize.Small" data-testid="icon-libraries-register" OnClick="RegisterLibrariesAsync">Register libraries</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" data-testid="icon-libraries-unregister" OnClick="UnregisterTablerAsync">Unregister Tabler</WaButton>
    </WaCluster>
    <p><code data-testid="icon-libraries-status">@libraryStatus</code></p>
    <div class="wa-cluster" style="font-size: 1.5em;">
        <WaIcon Library="lucide" Name="feather" Label="Lucide feather" data-testid="icon-lucide" />
        <WaIcon Library="heroicons" Name="cog-6-tooth" Label="Heroicons cog" data-testid="icon-heroicons" />
        <WaIcon Library="tabler" Name="brand-github" Label="Tabler GitHub" data-testid="icon-tabler" />
    </div>
</ExampleSection>

<ExampleSection Title="Default Icon Family" Code="@DefaultFamilyExample">
    <p>The default family applies to every icon without a <code>Family</code>. Families other than <code>classic</code> and <code>brands</code> need a Font Awesome Pro kit; on the free CDN those icons don't load.</p>
    <WaCluster Gap="GapSize.Gap_S">
        <WaButton Size="WaSize.Small" data-testid="icon-family-sharp" OnClick="@(() => SetDefaultFamilyAsync(SharpFamily))">Set to sharp</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" data-testid="icon-family-classic" OnClick="@(() => SetDefaultFamilyAsync(ClassicFamily))">Reset to classic</WaButton>
    </WaCluster>
    <p>Default family: <code data-testid="icon-family-current">@defaultFamily</code></p>
</ExampleSection>

<ApiTable Tag="wa-icon" />

@code {
    private const string LucideVersion = "1.8.0";
    private const string TablerLibrary = "tabler";
    private const string TablerResolver = "https://cdn.jsdelivr.net/npm/@tabler/icons@2.47.0/icons/{name}.svg";
    private const string TablerMutator = "demoIcons.thinStroke";
    private const string SharpFamily = "sharp";
    private const string ClassicFamily = "classic";

    private string libraryStatus = "Not registered";
    private string defaultFamily = "(not read yet)";

    private async Task RegisterLibrariesAsync()
    {
        try
        {
            await IconLibraries.RegisterLucideAsync(LucideVersion);
            await IconLibraries.RegisterHeroiconsAsync();
            await IconLibraries.RegisterIconLibraryAsync(TablerLibrary, new IconLibraryOptions
            {
                Resolver = TablerResolver,
                Mutator = TablerMutator
            });
            libraryStatus = "Registered lucide, heroicons, tabler";
        }
        catch (InvalidOperationException ex)
        {
            libraryStatus = $"Error: {ex.Message}";
        }
    }

    private async Task UnregisterTablerAsync()
    {
        await IconLibraries.UnregisterIconLibraryAsync(TablerLibrary);
        libraryStatus = "Unregistered tabler";
    }

    private async Task SetDefaultFamilyAsync(string family)
    {
        await IconLibraries.SetDefaultIconFamilyAsync(family);
        defaultFamily = await IconLibraries.GetDefaultIconFamilyAsync();
    }

    private const string IconLibrariesExample = """
        @inject WaIconLibraryService IconLibraries

        <WaButton OnClick="RegisterLibrariesAsync">Register libraries</WaButton>

        <WaIcon Library="lucide" Name="feather" />
        <WaIcon Library="heroicons" Name="cog-6-tooth" />
        <WaIcon Library="tabler" Name="brand-github" />

        @code {
            private async Task RegisterLibrariesAsync()
            {
                await IconLibraries.RegisterLucideAsync("1.8.0");
                await IconLibraries.RegisterHeroiconsAsync();
                await IconLibraries.RegisterIconLibraryAsync("tabler", new IconLibraryOptions
                {
                    Resolver = "https://cdn.jsdelivr.net/npm/@tabler/icons@2.47.0/icons/{name}.svg",
                    // window.demoIcons.thinStroke = svg => svg.setAttribute('stroke-width', '1.25')
                    Mutator = "demoIcons.thinStroke"
                });
            }
        }
        """;

    private const string DefaultFamilyExample = """
        await IconLibraries.SetDefaultIconFamilyAsync("sharp");
        var family = await IconLibraries.GetDefaultIconFamilyAsync();
        """;

    private const string DefaultExample = """
