            <WaOtpInput Label="Alpha" Type="WaOtpInputType.Alpha" @bind-Value="alphaValue" />
            <WaOtpInput Label="Alphanumeric" Type="WaOtpInputType.Alphanumeric" @bind-Value="alphanumericValue" />
        </WaStack>
        """;

    private const string FormatExample = """
        @* # marks a segment; any other character becomes a literal separator and overrides Length *@
        <WaStack Gap="GapSize.Gap_M">
            <WaOtpInput Label="Invite code" Type="WaOtpInputType.Alphanumeric" Format="### ###" @bind-Value="inviteValue" />
