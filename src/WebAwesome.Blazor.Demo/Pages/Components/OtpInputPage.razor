        </WaStack>
        """;

    private const string MaskExample = """
        @* Mask hides entered characters; WithMask also shows the mask character in empty segments *@
        <WaStack Gap="GapSize.Gap_M">
            <WaOtpInput Label="PIN, entered characters masked" Length="4" Mask="true" @bind-Value="maskedValue" />
            <WaOtpInput Label="PIN, empty segments masked too" Length="4" Mask="true" WithMask="true" @bind-Value="fullyMaskedValue" />
        </WaStack>
        """;

    private const string AppearanceExample = """
        <WaStack Gap="GapSize.Gap_M">
            <WaOtpInput Label="Outlined" Appearance="WaOtpInputAppearance.Outlined" @bind-Value="outlinedValue" />
            <WaOtpInput Label="Filled" Appearance="WaOtpInputAppearance.Filled" @bind-Value="filledValue" />
            <WaOtpInput Label="Filled outlined" Appearance="WaOtpInputAppearance.FilledOutlined" @bind-Value="filledOutlinedValue" />
            <WaOtpInput Label="Contained" Appearance="WaOtpInputAppearance.Contained" @bind-Value="containedValue" />
        </WaStack>
