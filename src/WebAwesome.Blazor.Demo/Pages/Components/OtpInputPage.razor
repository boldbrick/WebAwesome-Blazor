            <WaOtpInput Label="Magic link code" @bind-Value="magicLinkValue" />
            <WaOtpInput Label="Verification code" Disabled="true" @bind-Value="disabledValue" />
            <WaOtpInput Label="Confirmation code" Readonly="true" @bind-Value="readonlyValue" />
        </WaStack>

        @code {
            private string? magicLinkValue = "271828";
            private string? disabledValue = "391824";
            private string? readonlyValue = "483920";
        }
        """;

    private const string CompletionExample = """
        <WaOtpInput @ref="completionInput" Label="Two-factor code" Hint="Enter all six digits to complete the code."
                    @bind-Value="completionValue" OnComplete="HandleComplete" OnClear="HandleClear" />
        <WaDivider />
        <WaCluster Gap="GapSize.Gap_S" AlignItems="AlignItems.Center">
            <WaButton Appearance="WaAppearance.Outlined" OnClick="ClearCompletionAsync">Clear</WaButton>
            <span>Completed <strong>@completeCount</strong> time(s), cleared <strong>@clearCount</strong> time(s).</span>
        </WaCluster>

        @code {
