    private void SubmitTags() => submittedTags = string.Join(", ", requiredTags ?? []);

    // flags every invite that is not an email address; an empty message clears the error
    private async Task ValidateInvitesAsync()
    {
        var invalid = (invites ?? []).Where(tag => !tag.Contains('@')).ToList();
        await inviteInput!.SetCustomValidityAsync(invalid.Count > 0 ? $"Not an email address: {string.Join(", ", invalid)}" : string.Empty);
    }

