@page "/components/step"

<PageTitle>Step</PageTitle>

<h1>Step <ComponentBadges Tag="wa-step" /></h1>
<p>
    Steps are the individual stages of a <a href="components/stepper"><code>WaStepper</code></a> and must be its children.
    <code>Name</code> identifies the step, the child content is its label.
</p>

<ExampleSection Title="Description" Code="@DescriptionExample">
    <WaStepper Active="shipping">
        <WaStep Name="cart" Completed="true">
            <ChildContent>Cart</ChildContent>
            <DescriptionContent>3 items</DescriptionContent>
        </WaStep>
        <WaStep Name="shipping">
            <ChildContent>Shipping</ChildContent>
            <DescriptionContent>Enter your address</DescriptionContent>
        </WaStep>
        <WaStep Name="payment">
            <ChildContent>Payment</ChildContent>
            <DescriptionContent>Add a card</DescriptionContent>
        </WaStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Custom Icon" Code="@IconExample">
    <p><code>IconContent</code> replaces the step's number, checkmark or spinner; <code>IconName</code> is the shortcut for a single <code>WaIcon</code>.</p>
    <WaStepper Active="shipped">
        <WaStep Name="ordered" Completed="true">
            <IconContent><WaIcon Name="bag-shopping" /></IconContent>
            <ChildContent>Ordered</ChildContent>
            <DescriptionContent>Monday</DescriptionContent>
        </WaStep>
        <WaStep Name="shipped" IconName="truck">
            <ChildContent>Shipped</ChildContent>
            <DescriptionContent>Left the warehouse</DescriptionContent>
        </WaStep>
        <WaStep Name="delivered" IconName="house">
            <ChildContent>Delivered</ChildContent>
            <DescriptionContent>Thursday, probably</DescriptionContent>
        </WaStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Loading" Code="@LoadingExample">
    <WaStepper Active="steep">
        <WaStep Name="boil" Completed="true">Boil the kettle</WaStep>
        <WaStep Name="warm" Completed="true">Warm the pot</WaStep>
        <WaStep Name="steep" Loading="true">
            <ChildContent>Steep</ChildContent>
            <DescriptionContent>Four minutes for a proper cuppa</DescriptionContent>
        </WaStep>
        <WaStep Name="pour">Pour</WaStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Drawing Attention" Code="@AttentionExample">
    <WaStack Gap="GapSize.Gap_L">
        <WaStepper Active="verify">
            <WaStep Name="account" Completed="true">Create account</WaStep>
            <WaStep Name="verify" Attention="WaAttention.Pulse">Verify email</WaStep>
            <WaStep Name="profile">Set up profile</WaStep>
        </WaStepper>
        <WaStepper Active="verify">
            <WaStep Name="account" Completed="true">Create account</WaStep>
            <WaStep Name="verify" Attention="WaAttention.Bounce">Verify email</WaStep>
            <WaStep Name="profile">Set up profile</WaStep>
        </WaStepper>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Disabled" Code="@DisabledExample">
    <WaStepper Active="cart" Clickable="true">
        <WaStep Name="cart">Cart</WaStep>
        <WaStep Name="shipping">Shipping</WaStep>
        <WaStep Name="gift-wrap" Disabled="true">Gift Wrap</WaStep>
        <WaStep Name="payment">Payment</WaStep>
    </WaStepper>
</ExampleSection>

<ExampleSection Title="Variant" Code="@VariantExample">
    <p>The color is cosmetic: pair a warning or danger step with an icon and a reason in its label or description.</p>
    <WaStepper Active="current">
        <WaStep Name="current">Current</WaStep>
        <WaStep Name="success" Variant="WaVariant.Success">Success</WaStep>
        <WaStep Name="warning" Variant="WaVariant.Warning">Warning</WaStep>
        <WaStep Name="danger" Variant="WaVariant.Danger">Danger</WaStep>
    </WaStepper>
</ExampleSection>

