            <WaOption Value="@nameof(WaTreeSelection.Leaf)">Leaf</WaOption>
            <WaOption Value="@nameof(WaTreeSelection.LeafMultiple)">Leaf multiple</WaOption>
        </WaSelect>
        <WaTree Selection="selection" OnSelectionChange="e => selectedCount = e.Selection?.Length ?? 0">
            <WaTreeItem Expanded="true">
