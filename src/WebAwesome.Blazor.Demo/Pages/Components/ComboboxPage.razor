@page "/components/combobox"

<PageTitle>Combobox</PageTitle>

<h1>Combobox <ComponentBadges Tag="wa-combobox" /></h1>
<p>Comboboxes combine a text input with a filterable list of predefined options. <code>&lt;wa-combobox&gt;</code> wrapped by <code>WaCombobox</code>, with <code>&lt;wa-option&gt;</code> wrapped by <code>WaOption</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaCombobox Label="Choose a fruit" Placeholder="Type to filter" @bind-Value="defaultValue">
        <WaOption Value="apple">Apple</WaOption>
        <WaOption Value="banana">Banana</WaOption>
        <WaOption Value="cherry">Cherry</WaOption>
        <WaOption Value="grape">Grape</WaOption>
        <WaOption Value="orange">Orange</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Hint, Clearable &amp; Disabled" Code="@HintExample">
    <WaCombobox Label="Experience" Hint="Please tell us your skill level." WithClear="true" @bind-Value="experienceValue">
        <WaOption Value="1">Novice</WaOption>
        <WaOption Value="2">Intermediate</WaOption>
        <WaOption Value="3">Advanced</WaOption>
    </WaCombobox>
    <WaCombobox Placeholder="Disabled" Disabled="true" @bind-Value="disabledValue">
        <WaOption Value="option-1">Option 1</WaOption>
        <WaOption Value="option-2">Option 2</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Custom Values" Code="@CustomValueExample">
    <WaCombobox Label="Tag" Hint="Pick a suggestion or type your own." AllowCustomValue="true" @bind-Value="customValue">
        <WaOption Value="bug">bug</WaOption>
        <WaOption Value="enhancement">enhancement</WaOption>
        <WaOption Value="documentation">documentation</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Multiple Selection" Code="@MultipleExample">
    <WaCombobox Label="Select a few" Multiple="true" WithClear="true" MaxOptionsVisible="2" @bind-Value="multipleValue" SelectedValues="@selectedValues" SelectedValuesChanged="@(v => selectedValues = v)">
        <WaOption Value="option-1">Option 1</WaOption>
        <WaOption Value="option-2">Option 2</WaOption>
        <WaOption Value="option-3">Option 3</WaOption>
        <WaOption Value="option-4">Option 4</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Appearance &amp; Pill" Code="@AppearanceExample">
    <WaCombobox Appearance="WaInputAppearance.Filled" Placeholder="Filled" @bind-Value="filledValue">
        <WaOption Value="option-1">Option 1</WaOption>
        <WaOption Value="option-2">Option 2</WaOption>
    </WaCombobox>
    <WaCombobox Pill="true" Placeholder="Pill" @bind-Value="pillValue">
        <WaOption Value="option-1">Option 1</WaOption>
        <WaOption Value="option-2">Option 2</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Start &amp; End Decorations" Code="@DecorationsExample">
    <WaCombobox Placeholder="Destination" StartIconName="house" EndIconName="flag-checkered" @bind-Value="destinationValue">
        <WaOption Value="option-1">Option 1</WaOption>
        <WaOption Value="option-2">Option 2</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Loading Options from a Server" Code="@ServerExample">
    <p>
        With <code>Server</code>, the combobox stops filtering locally: it raises <code>OnOptionsRequest</code> when the
        listbox opens and again after a <code>FilterDebounce</code> pause in typing, and the handler swaps in the matching
        <code>WaOption</code> children. The wrapper clears the loading state once the handler has completed.
        <code>EmptyContent</code>, <code>LoadingContent</code> and <code>NoResultsContent</code> replace the status messages.
        Web Awesome's JavaScript-only <code>dataSource</code> callback isn't supported.
    </p>
    <WaCombobox Label="Country" Placeholder="Search countries" Server="true" WithClear="true" @bind-Value="countryValue"
                OnOptionsRequest="LoadCountriesAsync">
        <ChildContent>
            @foreach (var country in countryOptions)
            {
                <WaOption @key="country.Value" Value="@country.Value">@country.Label</WaOption>
            }
        </ChildContent>
        <EmptyContent>Start typing to find a country.</EmptyContent>
        <LoadingContent>Searching countries…</LoadingContent>
        <NoResultsContent>No countries match your search.</NoResultsContent>
    </WaCombobox>
    <p>Selected: <code>@(countryValue ?? "(none)")</code></p>
</ExampleSection>

<ApiTable Tag="wa-combobox" />

@code {
    private string? defaultValue;
    private string? experienceValue = "1";
    private string? disabledValue;
    private string? customValue;
    private string? multipleValue;
    private IReadOnlyList<string>? selectedValues = ["option-1", "option-2"];
    private string? filledValue = "option-1";
    private string? pillValue = "option-1";
    private string? destinationValue;

    // stands in for the latency of a request to your server
    private const int ServerLatencyMs = 500;

    private static readonly (string Value, string Label)[] Countries =
    [
        ("ar", "Argentina"), ("au", "Australia"), ("br", "Brazil"), ("ca", "Canada"), ("fr", "France"),
        ("de", "Germany"), ("in", "India"), ("jp", "Japan"), ("mx", "Mexico"), ("no", "Norway"),
    ];

    private string? countryValue;
    private (string Value, string Label)[] countryOptions = [];
    private int countryRequest;

    // an empty query shows the empty message; a request overtaken by a newer one is dropped
    private async Task LoadCountriesAsync(WaOptionsRequestEventArgs e)
    {
        var request = ++countryRequest;
        await Task.Delay(ServerLatencyMs);
        if (request != countryRequest) return;

        countryOptions = e.Query.Length == 0
            ? []
            : Countries.Where(country => country.Label.Contains(e.Query, StringComparison.OrdinalIgnoreCase)).ToArray();
    }

    private const string DefaultExample = """
        <WaCombobox Label="Choose a fruit" Placeholder="Type to filter" @bind-Value="defaultValue">
            <WaOption Value="apple">Apple</WaOption>
            <WaOption Value="banana">Banana</WaOption>
            <WaOption Value="cherry">Cherry</WaOption>
            <WaOption Value="grape">Grape</WaOption>
            <WaOption Value="orange">Orange</WaOption>
        </WaCombobox>

        @code {
            private string? defaultValue;
        }
        """;

    private const string HintExample = """
        <WaCombobox Label="Experience" Hint="Please tell us your skill level." WithClear="true" @bind-Value="experienceValue">
            <WaOption Value="1">Novice</WaOption>
            <WaOption Value="2">Intermediate</WaOption>
            <WaOption Value="3">Advanced</WaOption>
        </WaCombobox>
        <WaCombobox Placeholder="Disabled" Disabled="true" @bind-Value="disabledValue">
            <WaOption Value="option-1">Option 1</WaOption>
            <WaOption Value="option-2">Option 2</WaOption>
        </WaCombobox>

        @code {
            private string? experienceValue = "1";
            private string? disabledValue;
        }
        """;

    private const string CustomValueExample = """
        <WaCombobox Label="Tag" Hint="Pick a suggestion or type your own." AllowCustomValue="true" @bind-Value="customValue">
            <WaOption Value="bug">bug</WaOption>
            <WaOption Value="enhancement">enhancement</WaOption>
            <WaOption Value="documentation">documentation</WaOption>
        </WaCombobox>

        @code {
            private string? customValue;
        }
        """;

    private const string MultipleExample = """
        <WaCombobox Label="Select a few" Multiple="true" WithClear="true" MaxOptionsVisible="2" @bind-Value="multipleValue"
                    SelectedValues="@selectedValues" SelectedValuesChanged="@(v => selectedValues = v)">
            <WaOption Value="option-1">Option 1</WaOption>
            <WaOption Value="option-2">Option 2</WaOption>
            <WaOption Value="option-3">Option 3</WaOption>
            <WaOption Value="option-4">Option 4</WaOption>
        </WaCombobox>

        @code {
            private string? multipleValue;
            private IReadOnlyList<string>? selectedValues = ["option-1", "option-2"];
        }
        """;

    private const string AppearanceExample = """
        <WaCombobox Appearance="WaInputAppearance.Filled" Placeholder="Filled" @bind-Value="filledValue">
            <WaOption Value="option-1">Option 1</WaOption>
            <WaOption Value="option-2">Option 2</WaOption>
        </WaCombobox>
        <WaCombobox Pill="true" Placeholder="Pill" @bind-Value="pillValue">
            <WaOption Value="option-1">Option 1</WaOption>
            <WaOption Value="option-2">Option 2</WaOption>
        </WaCombobox>

        @code {
            private string? filledValue = "option-1";
            private string? pillValue = "option-1";
        }
        """;

    private const string DecorationsExample = """
        <WaCombobox Placeholder="Destination" StartIconName="house" EndIconName="flag-checkered" @bind-Value="destinationValue">
            <WaOption Value="option-1">Option 1</WaOption>
            <WaOption Value="option-2">Option 2</WaOption>
        </WaCombobox>

        @code {
            private string? destinationValue;
        }
        """;

    private const string ServerExample = """
        <WaCombobox Label="Country" Placeholder="Search countries" Server="true" WithClear="true" @bind-Value="countryValue"
                    OnOptionsRequest="LoadCountriesAsync">
            <ChildContent>
                @foreach (var country in countryOptions)
                {
                    <WaOption @key="country.Value" Value="@country.Value">@country.Label</WaOption>
                }
            </ChildContent>
            <EmptyContent>Start typing to find a country.</EmptyContent>
            <LoadingContent>Searching countries…</LoadingContent>
            <NoResultsContent>No countries match your search.</NoResultsContent>
        </WaCombobox>
        <p>Selected: <code>@(countryValue ?? "(none)")</code></p>

        @code {
            // stands in for the latency of a request to your server
            private const int ServerLatencyMs = 500;

            private static readonly (string Value, string Label)[] Countries =
            [
                ("ar", "Argentina"), ("au", "Australia"), ("br", "Brazil"), ("ca", "Canada"), ("fr", "France"),
                ("de", "Germany"), ("in", "India"), ("jp", "Japan"), ("mx", "Mexico"), ("no", "Norway"),
            ];

            private string? countryValue;
            private (string Value, string Label)[] countryOptions = [];
            private int countryRequest;

            // an empty query shows the empty message; a request overtaken by a newer one is dropped
            private async Task LoadCountriesAsync(WaOptionsRequestEventArgs e)
            {
                var request = ++countryRequest;
                await Task.Delay(ServerLatencyMs);
                if (request != countryRequest) return;

                countryOptions = e.Query.Length == 0
                    ? []
                    : Countries.Where(country => country.Label.Contains(e.Query, StringComparison.OrdinalIgnoreCase)).ToArray();
            }
        }
        """;
}
