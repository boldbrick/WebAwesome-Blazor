    private bool serverLoading;
    private int serverRequestCount;

    #region ------ Event handlers ------

    private void HandleSortChange(WaDataGridSortChangeEventArgs e)
    {
        sortSummary = e.Sort is null || e.Sort.Count == 0
            ? "none"
            : string.Join(", ", e.Sort.Select(s => $"{s.Id} {(s.Desc ? "descending" : "ascending")}"));
    }

    private void HandleRowSelect(WaDataGridRowSelectEventArgs e) => selectedCount = e.SelectedKeys?.Count ?? 0;

    private void HandlePageChange(WaDataGridPageChangeEventArgs e) => transactionPage = e.Page;

    private void HandleFilterChange(WaDataGridFilterChangeEventArgs e)
    {
        searchTerm = e.Search;
        filterCount = e.Filters?.Count ?? 0;
    }

    private void HandleCellClick(WaDataGridCellClickEventArgs e)
    {
        cellClickMessage = $"Clicked the \"{e.Column}\" cell of row {e.RowIndex}; its value is {e.Value}.";
    }

    // server mode: the grid asks for the rows it needs, we fetch them and hand back Data, Total and Loading
    private async Task HandleDataRequestAsync(WaDataGridDataRequestEventArgs e)
    {
        serverLoading = true;
        serverRequestCount++;
        StateHasChanged();

        // stand in for a network round trip
        await Task.Delay(500);

        var query = allOrders.AsEnumerable();

        var term = e.Search;
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(o => o.Customer.Contains(term, StringComparison.OrdinalIgnoreCase));

        var sort = e.Sort is { Count: > 0 } ? e.Sort[0] : null;
        if (sort is not null)
        {
            query = sort.Id switch
            {
                "customer" => sort.Desc ? query.OrderByDescending(o => o.Customer) : query.OrderBy(o => o.Customer),
                "amount" => sort.Desc ? query.OrderByDescending(o => o.Amount) : query.OrderBy(o => o.Amount),
                "status" => sort.Desc ? query.OrderByDescending(o => o.Status) : query.OrderBy(o => o.Status),
                _ => query
            };
        }

        var matches = query.ToList();
        serverTotal = matches.Count;
        serverRows = matches.Skip(e.Page * e.PageSize).Take(e.PageSize).Cast<object>().ToArray();
        serverLoading = false;
    }

    private async Task DownloadCsvAsync()
    {
        if (exportGrid is not null)
            await exportGrid.ExportDataAsCsvAsync(new WaDataGridCsvExportOptions { FileName = "expenses" });
    }

    private async Task PreviewCsvAsync()
    {
        if (exportGrid is not null)
            csvPreview = await exportGrid.GetDataAsCsvAsync();
    }

    private async Task CopyRowsAsync()
    {
        if (exportGrid is not null)
            copiedRows = await exportGrid.CopySelectedRowsAsync(new WaDataGridCopyOptions { Format = "csv" });
    }

