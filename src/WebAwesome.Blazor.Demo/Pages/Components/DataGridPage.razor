            [JsonConverter(typeof(JsonStringEnumConverter))]
            private enum OrderState { New, Processing, Shipped, Cancelled }

            private sealed record PresetOrderRow(int Id, string Customer, OrderState State, int Items, decimal Total, DateOnly Due, string Region, bool Paid);

            private readonly object[] presetOrders =
            [
                new PresetOrderRow(1001, "Ada Lovelace", OrderState.Shipped, 3, 129.90m, new DateOnly(2026, 10, 2), "EU", true),
                new PresetOrderRow(1002, "Grace Hopper", OrderState.Processing, 12, 1480m, new DateOnly(2026, 10, 18), "NA", false),
                new PresetOrderRow(1003, "Alan Turing", OrderState.New, 1, 19.99m, new DateOnly(2026, 10, 21), "EU", false),
                new PresetOrderRow(1004, "Katherine Johnson", OrderState.Cancelled, 5, 315.50m, new DateOnly(2026, 9, 30), "NA", true),
                new PresetOrderRow(1005, "Hedy Lamarr", OrderState.Processing, 2, 74m, new DateOnly(2026, 10, 25), "APAC", true)
            ];

            private readonly WaDataGridColumn[] presetColumns =
            [
                new() { Field = "id", Label = "Order", Width = 110, Formatter = WaDataGridFormatters.ActionLink("open", "#{id}") },
                new() { Field = "customer", Label = "Customer", Flex = 2, MinWidth = 170 },
                new()
                {
                    Field = "state", Label = "State", Width = 140,
                    // a state badge, from C# only; the sort follows the workflow, not the alphabet
                    Formatter = WaDataGridFormatters.Badge<OrderState>(state => state switch
                    {
                        OrderState.Processing => WaVariant.Brand,
                        OrderState.Shipped => WaVariant.Success,
                        OrderState.Cancelled => WaVariant.Danger,
                        _ => WaVariant.Neutral,
                    }),
                    ComparatorFunction = WaDataGridComparators.Ordinal<OrderState>()
                },
                new() { Field = "items", Label = "Items", Align = WaDataGridAlign.End, Width = 90, Formatter = WaDataGridFormatters.Number() },
                new() { Field = "total", Label = "Total", Align = WaDataGridAlign.End, Width = 130, Formatter = WaDataGridFormatters.Currency("EUR") },
                new() { Field = "due", Label = "Due", Width = 140, Formatter = WaDataGridFormatters.Date(WaDataGridDateStyle.Medium) },
                new()
                {
                    Field = "region", Label = "Region", Width = 150,
                    Formatter = WaDataGridFormatters.Lookup(new Dictionary<string, string> { ["EU"] = "Europe", ["NA"] = "North America", ["APAC"] = "Asia-Pacific" })
                },
                new()
                {
                    Field = "paid", Label = "Paid", Width = 90, Align = WaDataGridAlign.Center,
                    Formatter = WaDataGridFormatters.BooleanIcon("Paid", "Not paid", trueColor: WaVariant.Success, falseColor: WaVariant.Danger)
                }
            ];

            // the order links raise the "open" action; a click on them does not raise OnCellClick
            private void HandlePresetCellAction(WaDataGridCellActionEventArgs e)
            {
                var order = e.GetRow<PresetOrderRow>();
                presetActionMessage = $"Action \"{e.Action}\" for order {e.RowKey} (display row {e.RowIndex}): {order?.Customer}, {order?.State}.";
            }

            private void HandlePresetCellClick(WaDataGridCellClickEventArgs e)
            {
                presetClickMessage = $"OnCellClick: the \"{e.Column}\" cell of display row {e.RowIndex}.";
            }
        }
        """;

    private const string CellClickExample = """
        <WaDataGrid Label="Countries" RowKey="code" Data="countries" Columns="cellClickColumns" OnCellClick="HandleCellClick" />
        <WaDivider />
        <p>@(cellClickMessage ?? "Click any cell to see what the event reports.")</p>

        @code {
            private string? cellClickMessage;

            private void HandleCellClick(WaDataGridCellClickEventArgs e)
            {
                cellClickMessage = $"Clicked the \"{e.Column}\" cell of row {e.RowIndex}; its value is {e.Value}.";
            }
        }
        """;

    private const string ExportExample = """
        <WaCluster Gap="GapSize.Gap_S" Style="margin-block-end: var(--wa-space-m);">
            <WaButton Size="WaSize.Small" StartIconName="download" OnClick="DownloadCsvAsync">Download CSV</WaButton>
            <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" OnClick="PreviewCsvAsync">Preview CSV</WaButton>
            <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" StartIconName="copy" OnClick="CopyRowsAsync">Copy selected rows</WaButton>
        </WaCluster>
        <WaDataGrid @ref="exportGrid" Label="Expenses" RowKey="id" Selectable="WaDataGridSelectable.Multiple"
                    Data="expenses" Columns="expenseColumns" />
        @if (copiedRows > 0)
        {
            <p>Copied <strong>@copiedRows</strong> row(s) to the clipboard.</p>
        }
        @if (csvPreview is not null)
        {
            <pre style="overflow-x: auto;"><code>@csvPreview</code></pre>
        }

        @code {
            private WaDataGrid? exportGrid;
            private string? csvPreview;
            private int copiedRows;

            private async Task DownloadCsvAsync()
            {
                if (exportGrid is not null)
                    await exportGrid.ExportDataAsCsvAsync(new WaDataGridCsvExportOptions { FileName = "expenses" });
            }

            private async Task PreviewCsvAsync()
            {
                if (exportGrid is not null)
                    csvPreview = await exportGrid.GetDataAsCsvAsync();
            }

            private async Task CopyRowsAsync()
            {
                if (exportGrid is not null)
                    copiedRows = await exportGrid.CopySelectedRowsAsync(new WaDataGridCopyOptions { Format = "csv" });
            }
        }
        """;

    #endregion
}
