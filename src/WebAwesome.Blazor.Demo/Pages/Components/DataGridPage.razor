@page "/components/data-grid"
@using WebAwesome.Blazor.Models

<PageTitle>Data Grid</PageTitle>

<h1>Data Grid <ComponentBadges Tag="wa-data-grid" /></h1>
<p>
    Data grids display tabular data with sorting, selection, filtering, pinning, grouping, tree data,
    column footers, pagination, CSV export and full keyboard navigation.
    <code>&lt;wa-data-grid&gt;</code> wrapped by <code>WaDataGrid</code>. Rows and columns are JavaScript
    properties rather than attributes, so <code>Data</code> and <code>Columns</code> are supplied as typed
    C# parameters — a <code>WaDataGridColumn</code> list — and pushed to the element for you. Upstream's
    per-cell <code>formatter</code> is a JavaScript function or Lit template and cannot cross the interop
    boundary, so cells render their raw values; format the value in your row data when you need control
    over how it reads.
</p>

<ExampleSection Title="Columns" Code="@ColumnsExample">
    <WaDataGrid Label="Inventory" RowKey="sku" Data="inventory" Columns="inventoryColumns" />
</ExampleSection>

<ExampleSection Title="Striped Rows &amp; Size" Code="@StripedExample">
    <WaDataGrid Label="Periodic table" RowKey="number" Striped="true" Size="WaSize.Small"
                Data="elements" Columns="elementColumns" />
</ExampleSection>

<ExampleSection Title="Sorting" Code="@SortingExample">
    <WaDataGrid Label="Standings" RowKey="id" MaxMultiSort="3" Data="standings" Columns="standingColumns"
                OnSortChange="HandleSortChange" />
    <WaDivider />
    <p>Active sort: <strong>@sortSummary</strong> — Shift-click a second header to sort by more than one column.</p>
</ExampleSection>

<ExampleSection Title="Selection" Code="@SelectionExample">
    <WaDataGrid Label="Subscribers" RowKey="id" Selectable="WaDataGridSelectable.Multiple"
                Data="subscribers" Columns="subscriberColumns" OnRowSelect="HandleRowSelect" />
    <WaDivider />
    <p>Selected: <strong>@selectedCount</strong> of @subscribers.Length subscribers.</p>
</ExampleSection>

<ExampleSection Title="Single Selection" Code="@SingleSelectionExample">
    <WaDataGrid Label="Pick a plan" RowKey="id" Selectable="WaDataGridSelectable.Single"
                Data="plans" Columns="planColumns" />
</ExampleSection>

<ExampleSection Title="Pagination" Code="@PaginationExample">
    <WaDataGrid Label="Transactions" RowKey="id" Paginate="true" PageSize="10"
                Data="transactions" Columns="transactionColumns" OnPageChange="HandlePageChange" />
    <WaDivider />
    <p>Page <strong>@(transactionPage + 1)</strong> — the grid's <code>Page</code> is 0-based.</p>
</ExampleSection>

<ExampleSection Title="Global Search &amp; Column Filters" Code="@SearchExample">
    <WaDataGrid Label="Countries" RowKey="code" WithSearch="true" Data="countries" Columns="countryColumns"
                OnFilterChange="HandleFilterChange" />
    <WaDivider />
    <p>Search term: <strong>@(string.IsNullOrEmpty(searchTerm) ? "(none)" : searchTerm)</strong>, active column filters: <strong>@filterCount</strong>.</p>
</ExampleSection>

<ExampleSection Title="Column Management" Code="@ColumnManagementExample">
    <WaCluster Gap="GapSize.Gap_S" Style="margin-block-end: var(--wa-space-m);">
        <WaButton Size="WaSize.Small" OnClick="@(() => managedGrid!.AutoSizeColumnsAsync())">Auto-size columns</WaButton>
        <WaButton Size="WaSize.Small" OnClick="@(() => managedGrid!.SizeColumnsToFitAsync())">Size to fit</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" OnClick="@(() => managedGrid!.ResetColumnsAsync())">Reset columns</WaButton>
    </WaCluster>
    <WaDataGrid @ref="managedGrid" Label="Employees" RowKey="id" WithColumnMenu="true" WithColumnsMenu="true"
                Resizable="true" Reorderable="true" Pinnable="true" Data="compensation" Columns="managedColumns" />
</ExampleSection>

<ExampleSection Title="Column Footers" Code="@FootersExample">
    <WaDataGrid Label="Invoice" RowKey="id" Data="invoiceItems" Columns="invoiceColumns" />
</ExampleSection>

<ExampleSection Title="Grouping Rows" Code="@GroupingExample">
    <WaCluster Gap="GapSize.Gap_S" Style="margin-block-end: var(--wa-space-m);">
        <WaButton Size="WaSize.Small" OnClick="@(() => groupedGrid!.ExpandAllRowsAsync())">Expand all groups</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" OnClick="@(() => groupedGrid!.CollapseAllRowsAsync())">Collapse all</WaButton>
    </WaCluster>
    <WaDataGrid @ref="groupedGrid" Label="Team compensation" RowKey="id" GroupBy="department"
                Data="compensation" Columns="groupedColumns" />
</ExampleSection>

<ExampleSection Title="Tree Data" Code="@TreeExample">
    <WaCluster Gap="GapSize.Gap_S" Style="margin-block-end: var(--wa-space-m);">
        <WaButton Size="WaSize.Small" OnClick="@(() => treeGrid!.ExpandAllRowsAsync())">Expand all folders</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" OnClick="@(() => treeGrid!.CollapseAllRowsAsync())">Collapse all</WaButton>
    </WaCluster>
    <WaDataGrid @ref="treeGrid" Label="Project files" RowKey="id" ChildRows="children" FilterFromLeafRows="true"
                WithSearch="true" Selectable="WaDataGridSelectable.Multiple" Data="projectFiles" Columns="fileColumns" />
</ExampleSection>

<ExampleSection Title="Empty &amp; No-Results States" Code="@EmptyExample">
    <WaDataGrid Label="Invoices" RowKey="id" WithSearch="true" Data="noInvoices" Columns="emptyColumns">
        <EmptyContent>
            <WaStack Gap="GapSize.Gap_S" AlignItems="AlignItems.Center" Style="padding: var(--wa-space-2xl) 0; text-align: center;">
                <WaIcon Name="file-invoice" Style="font-size: 2.5rem; color: var(--wa-color-text-quiet);" />
                <div>
                    <strong>No invoices yet</strong>
                    <p style="margin: 0.25em 0 0; color: var(--wa-color-text-quiet);">Create your first invoice to see it here.</p>
                </div>
                <WaButton Variant="WaVariant.Brand" StartIconName="plus">New invoice</WaButton>
            </WaStack>
        </EmptyContent>
        <NoResultsContent>
            <WaStack Gap="GapSize.Gap_XS" AlignItems="AlignItems.Center" Style="padding: var(--wa-space-xl) 0;">
                <WaIcon Name="magnifying-glass" Style="font-size: 2rem; color: var(--wa-color-text-quiet);" />
                <small>No invoice matches that search.</small>
            </WaStack>
        </NoResultsContent>
    </WaDataGrid>
</ExampleSection>

<ExampleSection Title="Loading Data from a Server" Code="@ServerExample">
    <WaDataGrid Label="Orders" RowKey="id" Server="true" Paginate="true" PageSize="8" WithSearch="true"
                FilterDebounce="300" Total="serverTotal" Loading="serverLoading"
                Data="serverRows" Columns="orderColumns" OnDataRequest="HandleDataRequestAsync">
        <LoadingContent>
            <WaStack Gap="GapSize.Gap_XS" AlignItems="AlignItems.Center">
                <WaSpinner Style="font-size: 2rem;" />
                <small>Loading orders…</small>
            </WaStack>
        </LoadingContent>
    </WaDataGrid>
    <WaDivider />
    <p>Served <strong>@serverRows.Length</strong> of <strong>@serverTotal</strong> matching orders in @serverRequestCount request(s).</p>
</ExampleSection>

<ExampleSection Title="Responding to Cell Clicks" Code="@CellClickExample">
    <WaDataGrid Label="Countries" RowKey="code" Data="countries" Columns="cellClickColumns" OnCellClick="HandleCellClick" />
    <WaDivider />
    <p>@(cellClickMessage ?? "Click any cell to see what the event reports.")</p>
</ExampleSection>

<ExampleSection Title="CSV Export &amp; Clipboard" Code="@ExportExample">
    <WaCluster Gap="GapSize.Gap_S" Style="margin-block-end: var(--wa-space-m);">
        <WaButton Size="WaSize.Small" StartIconName="download" OnClick="DownloadCsvAsync">Download CSV</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" OnClick="PreviewCsvAsync">Preview CSV</WaButton>
        <WaButton Size="WaSize.Small" Appearance="WaAppearance.Outlined" StartIconName="copy" OnClick="CopyRowsAsync">Copy selected rows</WaButton>
    </WaCluster>
    <WaDataGrid @ref="exportGrid" Label="Expenses" RowKey="id" Selectable="WaDataGridSelectable.Multiple"
                Data="expenses" Columns="expenseColumns" />
    @if (copiedRows > 0)
    {
        <p>Copied <strong>@copiedRows</strong> row(s) to the clipboard.</p>
    }
    @if (csvPreview is not null)
    {
        <pre style="overflow-x: auto;"><code>@csvPreview</code></pre>
    }
</ExampleSection>

