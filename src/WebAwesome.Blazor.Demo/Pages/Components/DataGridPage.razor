    private const string ServerExample = """
        @* upstream's dataSource callback cannot cross the interop boundary; server mode is the Blazor path *@
        <WaDataGrid Label="Orders" RowKey="id" Server="true" Paginate="true" PageSize="8" WithSearch="true"
                    FilterDebounce="300" Total="serverTotal" Loading="serverLoading"
                    Data="serverRows" Columns="orderColumns" OnDataRequest="HandleDataRequestAsync">
            <LoadingContent>
                <WaStack Gap="GapSize.Gap_XS" AlignItems="AlignItems.Center">
                    <WaSpinner Style="font-size: 2rem;" />
                    <small>Loading orders…</small>
                </WaStack>
            </LoadingContent>
        </WaDataGrid>
        <WaDivider />
        <p>Served <strong>@serverRows.Length</strong> of <strong>@serverTotal</strong> matching orders in @serverRequestCount request(s).</p>

        @code {
            private object[] serverRows = [];
            private int serverTotal;
            private bool serverLoading;
            private int serverRequestCount;

            private async Task HandleDataRequestAsync(WaDataGridDataRequestEventArgs e)
            {
                serverLoading = true;
                serverRequestCount++;
                StateHasChanged();

                // stand in for a network round trip
                await Task.Delay(500);

                var query = allOrders.AsEnumerable();

                var term = e.Search;
                if (!string.IsNullOrWhiteSpace(term))
                    query = query.Where(o => o.Customer.Contains(term, StringComparison.OrdinalIgnoreCase));

                var sort = e.Sort is { Count: > 0 } ? e.Sort[0] : null;
                if (sort is not null)
                {
                    query = sort.Id switch
                    {
                        "customer" => sort.Desc ? query.OrderByDescending(o => o.Customer) : query.OrderBy(o => o.Customer),
                        "amount" => sort.Desc ? query.OrderByDescending(o => o.Amount) : query.OrderBy(o => o.Amount),
                        "status" => sort.Desc ? query.OrderByDescending(o => o.Status) : query.OrderBy(o => o.Status),
                        _ => query
                    };
                }

                var matches = query.ToList();
                serverTotal = matches.Count;
                serverRows = matches.Skip(e.Page * e.PageSize).Take(e.PageSize).Cast<object>().ToArray();
                serverLoading = false;
            }
        }
        """;

