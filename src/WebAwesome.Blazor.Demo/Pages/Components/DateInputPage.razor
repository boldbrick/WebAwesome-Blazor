@page "/components/date-input"

<PageTitle>Date Input</PageTitle>

<h1>Date Input <ComponentBadges Tag="wa-date-input" /></h1>
<p>Date inputs let users enter a date through a segmented field or select one from a popup calendar. <code>WaDateInput</code> binds a <code>DateOnly?</code>; the element's ISO 8601 wire value (<code>YYYY-MM-DD</code>) is converted culture-free. For a start and end date, use <a href="/components/date-range-input"><code>WaDateRangeInput</code></a>. <code>&lt;wa-date-input&gt;</code> wrapped by <code>WaDateInput</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaDateInput Label="Pick a date" @bind-Value="defaultValue" />
    <p>Value: <code>@(defaultValue is null ? "(empty)" : DemoFormat.Iso(defaultValue))</code></p>
</ExampleSection>

<ExampleSection Title="Initial Value &amp; Clearable" Code="@ValueExample">
    <WaDateInput Label="Event date" Hint="Choose the day of the event." WithClear="true" @bind-Value="eventValue" />
</ExampleSection>

<ExampleSection Title="Min &amp; Max" Code="@ConstraintsExample">
    <WaDateInput Label="Within 2026" Min="YearStart" Max="YearEnd" @bind-Value="constrainedValue" />
</ExampleSection>

<ExampleSection Title="Disabled Dates &amp; Weekdays" Code="@DisabledExample">
    <WaDateInput Label="Delivery day" Hint="No deliveries on weekends or public holidays." Today="DeliveryToday"
                 DisabledDaysOfWeek="Weekend" DisabledDates="Holidays" @bind-Value="deliveryValue" />
</ExampleSection>

<ExampleSection Title="Appearance &amp; Pill" Code="@AppearanceExample">
    <WaDateInput Label="Filled" Appearance="WaInputAppearance.Filled" @bind-Value="filledValue" />
    <WaDateInput Label="Pill" Pill="true" @bind-Value="pillValue" />
</ExampleSection>

<ApiTable Tag="wa-date-input" />

