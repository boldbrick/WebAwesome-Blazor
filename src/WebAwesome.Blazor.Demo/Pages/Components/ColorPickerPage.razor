@page "/components/color-picker"

<PageTitle>Color Picker</PageTitle>

<h1>Color Picker <ComponentBadges Tag="wa-color-picker" /></h1>
<p>Color pickers let the user choose a color. <code>&lt;wa-color-picker&gt;</code> wrapped by <code>WaColorPicker</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaColorPicker @bind-Value="value" />
</ExampleSection>

<ExampleSection Title="Label and Hint" Code="@LabelExample">
    <WaColorPicker Label="Brand color" Hint="Used for buttons and links." @bind-Value="labeled" />
    <p>Selected: <strong>@labeled</strong></p>
</ExampleSection>

<ExampleSection Title="Formats" Code="@FormatsExample">
    <WaCluster Gap="GapSize.Gap_L">
        <WaColorPicker Label="Hex" Format="WaColorFormat.Hex" @bind-Value="hex" />
        <WaColorPicker Label="RGB" Format="WaColorFormat.Rgb" @bind-Value="rgb" />
        <WaColorPicker Label="HSL" Format="WaColorFormat.Hsl" @bind-Value="hsl" />
        <WaColorPicker Label="HSV" Format="WaColorFormat.Hsv" @bind-Value="hsv" />
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Opacity and Uppercase" Code="@OpacityExample">
    <WaCluster Gap="GapSize.Gap_L">
        <WaColorPicker Label="With opacity" Opacity="true" @bind-Value="translucent" />
        <WaColorPicker Label="Uppercase hex" Uppercase="true" @bind-Value="upper" />
        <WaColorPicker Label="No format toggle" WithoutFormatToggle="true" @bind-Value="fixedFormat" />
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Swatches" Code="@SwatchesExample">
    <WaColorPicker Label="Pick a swatch" Swatches="@(new[] { "#d0021b", "#f5a623", "#f8e71c", "#8b572a", "#7ed321", "#417505", "#bd10e0", "#9013fe", "#4a90e2", "#50e3c2" })" @bind-Value="swatch" />
</ExampleSection>

<ExampleSection Title="Sizes" Code="@SizesExample">
    <WaCluster Gap="GapSize.Gap_L" AlignItems="AlignItems.End">
        <WaColorPicker Label="Small" Size="WaSize.Small" @bind-Value="small" />
        <WaColorPicker Label="Medium" Size="WaSize.Medium" @bind-Value="medium" />
        <WaColorPicker Label="Large" Size="WaSize.Large" @bind-Value="large" />
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Placement" Code="@PlacementExample">
    <WaCluster Gap="GapSize.Gap_L">
        <WaColorPicker Label="Opens above" Placement="WaPlacement.Top" @bind-Value="above" />
        <WaColorPicker Label="Opens to the right" Placement="WaPlacement.RightStart" @bind-Value="right" />
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Disabled" Code="@DisabledExample">
    <WaColorPicker Label="Theme color" Disabled="true" @bind-Value="disabled" />
</ExampleSection>

<ApiTable Tag="wa-color-picker" />

