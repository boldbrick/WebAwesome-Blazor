@page "/components/divider"

<PageTitle>Divider</PageTitle>

<h1>Divider <ComponentBadges Tag="wa-divider" /></h1>
<p>Dividers visually separate or group elements. <code>&lt;wa-divider&gt;</code> wrapped by <code>WaDivider</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <p>Above the divider</p>
    <WaDivider />
    <p>Below the divider</p>
</ExampleSection>

<ExampleSection Title="Width, Color and Spacing" Code="@StyleExample">
    <WaDivider Style="--width: 4px;" />
    <WaDivider Style="--color: var(--wa-color-brand-fill-loud);" />
    <WaDivider Style="--spacing: 2rem;" />
</ExampleSection>

<ExampleSection Title="Vertical" Code="@VerticalExample">
    <div style="display: flex; align-items: center; height: 2rem;">
        First
        <WaDivider Orientation="WaOrientation.Vertical" />
        Middle
        <WaDivider Orientation="WaOrientation.Vertical" />
        Last
    </div>
</ExampleSection>

<ExampleSection Title="Label" Code="@LabelExample">
    <WaStack Style="max-width: 20rem;">
        <WaButton Appearance="WaAppearance.Filled" Variant="WaVariant.Brand" StartIconName="envelope">Sign In with Email</WaButton>
        <WaDivider>or</WaDivider>
        <WaButton Appearance="WaAppearance.Outlined" StartIconName="key">Use a Passkey</WaButton>
    </WaStack>
</ExampleSection>

<ExampleSection Title="Label Placement" Code="@LabelPlacementExample">
    <WaDivider LabelPlacement="WaDividerLabelPlacement.Start">Start</WaDivider>
    <WaDivider LabelPlacement="WaDividerLabelPlacement.Center">Center</WaDivider>
    <WaDivider LabelPlacement="WaDividerLabelPlacement.End">End</WaDivider>
    <WaDivider LabelPlacement="WaDividerLabelPlacement.Start" Style="--label-offset: 4rem;">Start, offset 4rem</WaDivider>
</ExampleSection>

<ExampleSection Title="In Menus" Code="@MenuExample">
    <WaDropdown>
        <TriggerContent><WaButton WithCaret="true">Edit</WaButton></TriggerContent>
        <ChildContent>
            <WaDropdownItem Value="cut">Cut</WaDropdownItem>
            <WaDropdownItem Value="copy">Copy</WaDropdownItem>
            <WaDivider Orientation="WaOrientation.Horizontal" />
            <WaDropdownItem Value="delete" Variant="WaDropdownItemVariant.Danger">Delete</WaDropdownItem>
        </ChildContent>
    </WaDropdown>
</ExampleSection>

<ApiTable Tag="wa-divider" />

