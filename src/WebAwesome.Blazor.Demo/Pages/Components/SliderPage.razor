@page "/components/slider"

<PageTitle>Slider</PageTitle>

<h1>Slider <ComponentBadges Tag="wa-slider" /></h1>
<p>Sliders let the user pick a numeric value, or a range, from a track. <code>&lt;wa-slider&gt;</code> wrapped by <code>WaSlider</code>.</p>

<ExampleSection Title="Default" Code="@DefaultExample">
    <WaSlider @bind-Value="value" />
</ExampleSection>

<ExampleSection Title="Change Event" Code="@ChangeEventExample">
    <WaSlider Label="Volume" @bind-Value="volume" OnValueChange="@(newValue => volumeChanges++)" />
    <p>Volume: <strong>@volume</strong></p>
    <p>OnValueChange calls: <strong>@volumeChanges</strong></p>
</ExampleSection>

<ExampleSection Title="Label and Hint" Code="@HintExample">
    <WaSlider Label="Brightness" Hint="Applies to every connected display." @bind-Value="brightness" />
</ExampleSection>

<ExampleSection Title="Min, Max and Step" Code="@StepExample">
    <WaSlider Label="Temperature (°C)" Min="-10" Max="40" Step="0.5M" WithTooltip="true" @bind-Value="temperature" />
</ExampleSection>

<ExampleSection Title="Markers and Reference Labels" Code="@MarkersExample">
    <WaSlider Label="Speed" Min="1" Max="5" Step="1" WithMarkers="true" @bind-Value="speed">
        <ReferenceContent>
            <span>Slow</span>
            <span>Medium</span>
            <span>Fast</span>
        </ReferenceContent>
    </WaSlider>
</ExampleSection>

<ExampleSection Title="Tooltip Placement and Distance" Code="@TooltipExample">
    <WaStack Gap="GapSize.Gap_L">
        <WaSlider Label="Tooltip above" WithTooltip="true" TooltipPlacement="WaTooltipSide.Top" TooltipDistance="12" @bind-Value="above" />
        <WaSlider Label="Tooltip below" WithTooltip="true" TooltipPlacement="WaTooltipSide.Bottom" @bind-Value="below" />
    </WaStack>
</ExampleSection>

<ExampleSection Title="Range" Code="@RangeExample">
    <WaSlider Label="Price range" Range="true" Min="0" Max="500" Step="10" WithTooltip="true" @bind-MinValue="priceMin" @bind-MaxValue="priceMax" />
    <p>From <strong>@priceMin</strong> to <strong>@priceMax</strong></p>
</ExampleSection>

<ExampleSection Title="Vertical" Code="@VerticalExample">
    <WaCluster Gap="GapSize.Gap_2XL" Style="height: 200px;">
        <WaSlider Label="Bass" Orientation="WaOrientation.Vertical" WithTooltip="true" TooltipPlacement="WaTooltipSide.Left" @bind-Value="bass" />
        <WaSlider Label="Treble" Orientation="WaOrientation.Vertical" WithTooltip="true" TooltipPlacement="WaTooltipSide.Right" @bind-Value="treble" />
        <WaSlider Label="Balance" Orientation="WaOrientation.Horizontal" Min="-50" Max="50" IndicatorOffset="0" @bind-Value="balance" />
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Sizes" Code="@SizesExample">
    <WaStack Gap="GapSize.Gap_M">
        <WaSlider Label="Small" Size="WaSize.Small" @bind-Value="small" />
        <WaSlider Label="Medium" Size="WaSize.Medium" @bind-Value="medium" />
        <WaSlider Label="Large" Size="WaSize.Large" @bind-Value="large" />
    </WaStack>
</ExampleSection>

<ExampleSection Title="Readonly and Disabled" Code="@ReadonlyExample">
    <WaStack Gap="GapSize.Gap_M">
        <WaSlider Label="Readonly" Readonly="true" @bind-Value="locked" />
        <WaSlider Label="Disabled" Disabled="true" @bind-Value="disabled" />
    </WaStack>
</ExampleSection>

<ApiTable Tag="wa-slider" />

