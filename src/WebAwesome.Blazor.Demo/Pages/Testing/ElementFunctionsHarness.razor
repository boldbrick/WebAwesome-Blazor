@page "/testing/element-functions"
@using WebAwesome.Blazor.Models

@* e2e harness for tools\e2e\tests\element-functions.spec.js - deliberately outside /components/, so it is neither
   derived from api-surface.json nor linked from the sidebar; the sweep reaches it through HARNESS_ROUTES in
   tools\e2e\tests\helpers\routes.js. Each wrapper binds its function-valued member to an export of the collocated
   ElementFunctionsHarness.razor.js; the select, combobox, date picker, date input and data grid also set ShadowStyles.
   The buttons remove a function, change the styles, and call the obsolete string methods. The combobox, the date
   controls and the data grid are Pro components. *@

<PageTitle>Testing: Element Functions</PageTitle>

<h1>Element Functions Harness</h1>
<p>This page is an end-to-end test harness for the function-valued members of the element wrappers (<code>WaJsFunction</code> parameters) and <code>ShadowStyles</code>.</p>

<ExampleSection Title="Select tags and shadow styles">
    <WaSelect data-testid="ef-select" Label="Select" Multiple="true" @bind-Value="selectValue"
              SelectedValues="selectedValues" SelectedValuesChanged="@(v => selectedValues = v)"
              GetTagFunction="selectTagFunction" ShadowStyles="@tagStyles">
        <WaOption Value="alpha">Alpha</WaOption>
        <WaOption Value="beta">Beta</WaOption>
    </WaSelect>
    <WaCluster Gap="GapSize.Gap_S" Style="margin-block-start: var(--wa-space-m);">
        <WaButton data-testid="ef-change-styles" Size="WaSize.Small" OnClick="@(() => tagStyles = SecondTagStyles)">Change the styles</WaButton>
        <WaButton data-testid="ef-remove-tag-function" Size="WaSize.Small" OnClick="@(() => selectTagFunction = null)">Remove the tag function</WaButton>
    </WaCluster>
</ExampleSection>

<ExampleSection Title="Rating symbols">
    <WaRating data-testid="ef-rating" Label="Rating" @bind-Value="ratingValue" GetSymbolFunction="ratingSymbolFunction" />
</ExampleSection>

<ExampleSection Title="Slider and range value formatters">
    <WaSlider data-testid="ef-slider" Label="Slider" @bind-Value="sliderValue" ValueFormatterFunction="unitFormatter" />
    <WaRange data-testid="ef-range" Label="Range" @bind-Value="rangeValue" ValueFormatterFunction="unitFormatter" />
</ExampleSection>

<ExampleSection Title="Pagination links">
    <WaPagination data-testid="ef-pagination" Label="Pages" Total="50" PageSize="10" HrefTemplateFunction="pageHrefFunction" />
</ExampleSection>

<ExampleSection Title="Combobox tags and filter (Pro)">
    <WaCombobox data-testid="ef-combobox" Label="Combobox" Multiple="true" @bind-Value="comboboxValue"
                SelectedValues="comboboxSelectedValues" SelectedValuesChanged="@(v => comboboxSelectedValues = v)"
                GetTagFunction="comboboxTagFunction" FilterFunction="startsWithFunction" ShadowStyles="@FirstTagStyles">
        <WaOption Value="alpha">Alpha</WaOption>
        <WaOption Value="beta">Beta</WaOption>
        <WaOption Value="gamma">Gamma</WaOption>
        <WaOption Value="delta">Delta</WaOption>
    </WaCombobox>
</ExampleSection>

<ExampleSection Title="Calendar rules and day content (Pro)">
    <WaDatePicker data-testid="ef-date-picker" FocusedDate="CalendarMonth" @bind-Value="pickerValue"
                  IsDateDisabledFunction="weekendFunction" DayContentFunction="fifteenthFunction" ShadowStyles="@DayStyles" />
    <WaDateInput data-testid="ef-date-input" Label="Date input" @bind-Value="inputValue"
                 IsDateDisabledFunction="weekendFunction" DayContentFunction="fifteenthFunction" ShadowStyles="@DayStyles" />
    <WaDateRangeInput data-testid="ef-date-range-input" Label="Date range input" @bind-Value="rangeInputValue"
                      IsDateDisabledFunction="weekendFunction" DayContentFunction="fifteenthFunction" />
</ExampleSection>

<ExampleSection Title="Data grid shadow styles (Pro)">
    <WaDataGrid data-testid="ef-grid" Label="Classed cells" RowKey="id" Data="rows" Columns="columns" ShadowStyles="@CellStyles" />
</ExampleSection>

<ExampleSection Title="Obsolete string methods">
    <WaSelect @ref="obsoleteSelect" data-testid="ef-obsolete-select" Label="Obsolete select" Multiple="true"
              @bind-Value="obsoleteSelectValue" SelectedValues="obsoleteSelectedValues" SelectedValuesChanged="@(v => obsoleteSelectedValues = v)">
        <WaOption Value="alpha">Alpha</WaOption>
        <WaOption Value="beta">Beta</WaOption>
    </WaSelect>
    <WaRating @ref="obsoleteRating" data-testid="ef-obsolete-rating" Label="Obsolete rating" @bind-Value="obsoleteRatingValue" />
    <WaButton data-testid="ef-call-obsolete" Size="WaSize.Small" OnClick="CallObsoleteMethodsAsync">Call the obsolete methods</WaButton>
    <p>Select: <strong data-testid="ef-obsolete-select-result">@obsoleteSelectResult</strong>, rating: <strong data-testid="ef-obsolete-rating-result">@obsoleteRatingResult</strong></p>
</ExampleSection>

@code {
    // the collocated module of this page
    private const string HarnessModule = "./Pages/Testing/ElementFunctionsHarness.razor.js";

    private const string FirstTagStyles = ".ef-tag { color: rgb(255, 0, 0); }";
    private const string SecondTagStyles = ".ef-tag { color: rgb(0, 0, 255); }";
    private const string DayStyles = ".ef-day { color: rgb(0, 128, 0); }";
    private const string CellStyles = ".ef-cell { color: rgb(255, 0, 0); }";

    // the month the calendars show: March 2024 starts on a Friday, its 15th is a Friday too
    private static readonly DateOnly CalendarMonth = new(2024, 3, 12);

    // JavaScript source text, as the obsolete methods took it
    private const string TagSource = "(option) => `<wa-tag>${option.label}</wa-tag>`";
    private const string SymbolSource = "() => '<span>*</span>'";

    // the result text of an obsolete method call that did not throw
    private const string SentResult = "sent";

    private sealed record CellRow(int Id, string Name);

    private readonly object[] rows = [new CellRow(1, "Ada"), new CellRow(2, "Grace")];

    private readonly WaDataGridColumn[] columns =
    [
        new() { Field = "name", Label = "Name", Formatter = WaJsFunction.Module(HarnessModule, "classedCell") }
    ];

    private WaJsFunction? selectTagFunction = WaJsFunction.Module(HarnessModule, "markedTag").WithArgs(new { prefix = "* " });
    private readonly WaJsFunction comboboxTagFunction = WaJsFunction.Module(HarnessModule, "markedTag").WithArgs(new { prefix = "+ " });
    private readonly WaJsFunction ratingSymbolFunction = WaJsFunction.Module(HarnessModule, "dotSymbol").WithArgs(new { on = "#", off = "o" });
    private readonly WaJsFunction unitFormatter = WaJsFunction.Module(HarnessModule, "withUnit").WithArgs(new { unit = " units" });
    private readonly WaJsFunction pageHrefFunction = WaJsFunction.Module(HarnessModule, "pageHref").WithArgs(new { @base = "/testing/element-functions" });
    private readonly WaJsFunction startsWithFunction = WaJsFunction.Module(HarnessModule, "startsWith");
    private readonly WaJsFunction weekendFunction = WaJsFunction.Module(HarnessModule, "weekend");
    private readonly WaJsFunction fifteenthFunction = WaJsFunction.Module(HarnessModule, "markFifteenth").WithArgs(new { mark = "15!" });

    private string tagStyles = FirstTagStyles;
    private string? selectValue;
    private IReadOnlyList<string>? selectedValues = ["alpha", "beta"];
    private decimal ratingValue = 2;
    private decimal? sliderValue = 40;
    private decimal rangeValue = 25;
    private string? comboboxValue;
    private IReadOnlyList<string>? comboboxSelectedValues = ["alpha", "beta"];
    private DateOnly? pickerValue;
    private DateOnly? inputValue = CalendarMonth;
    private WaDateRange? rangeInputValue = new(CalendarMonth, null);

    private WaSelect obsoleteSelect = default!;
    private WaRating obsoleteRating = default!;
    private string? obsoleteSelectValue;
    private IReadOnlyList<string>? obsoleteSelectedValues = ["alpha", "beta"];
    private decimal obsoleteRatingValue = 3;
    private string? obsoleteSelectResult;
    private string? obsoleteRatingResult;

#pragma warning disable CS0618 // the harness proves the obsolete methods no longer break their element
    private async Task CallObsoleteMethodsAsync()
    {
        obsoleteSelectResult = await ResultOfAsync(() => obsoleteSelect.SetGetTagFunctionAsync(TagSource));
        obsoleteRatingResult = await ResultOfAsync(() => obsoleteRating.SetSymbolFunctionAsync(SymbolSource));
    }
#pragma warning restore CS0618

    // the type name of the exception a call throws, or SentResult
    private static async Task<string> ResultOfAsync(Func<Task> call)
    {
        try
        {
            await call();
            return SentResult;
        }
        catch (Exception exception)
        {
            return exception.GetType().Name;
        }
    }
}
