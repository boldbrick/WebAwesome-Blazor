<ExampleSection Title="Calls on the first render (?early=true)">
    <p>Select focus: <output data-testid="early-select-focus">@earlySelectFocus</output></p>
    <p>Color picker value as RGB: <output data-testid="early-color-format">@earlyColorFormat</output></p>
</ExampleSection>

@code {
    private const string ValidityMessage = "Pick one, please";
    private const string InitialColor = "#ff0000";
    private const string NotCalled = "not called";
    private const string DoneText = "done";
    private const string ErrorPrefix = "error: ";

    // a fixed "today", so the calendars show the same month on every run; the values lie in the same month
    private static readonly DateOnly Today = new(2026, 6, 10);
    private static readonly DateOnly InitialDate = new(2026, 6, 12);
    private static readonly WaDateRange InitialRange = new(new DateOnly(2026, 6, 8), new DateOnly(2026, 6, 12));

    // a date in another month and year than the initial values
    private static readonly DateOnly GoToTarget = new(2027, 3, 15);

    private static readonly string[] SwatchColors = ["#ff0000", "#00ff00", "#0000ff"];

    private WaColorPicker? colorPicker;
    private WaSelect? select;
    private WaTimeInput? timeInput;
    private WaDateInput? dateInput;
    private WaDateRangeInput? rangeInput;
    private WaDatePicker? datePicker;
    private WaDateRangePicker? rangePicker;

    private string? colorValue = InitialColor;
    private string? selectValue;
    private TimeOnly? timeValue;
    private DateOnly? dateInputValue = InitialDate;
    private WaDateRange? rangeInputValue = InitialRange;
    private DateOnly? datePickerValue = InitialDate;
    private WaDateRange? rangePickerValue = InitialRange;

    private string earlySelectFocus = NotCalled;
    private string earlyColorFormat = NotCalled;

    // ?early=true: the page calls methods on its first render, while the autoloader still imports the element modules
    [SupplyParameterFromQuery(Name = "early")] public bool CallOnFirstRender { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && CallOnFirstRender)
        {
            var selectFocus = OutcomeOf(async () => { await select!.FocusAsync(); return DoneText; });
            var colorFormat = OutcomeOf(() => colorPicker!.GetFormattedValueAsync(WaColorFormat.Rgb));
            await Task.WhenAll(selectFocus, colorFormat);
            earlySelectFocus = selectFocus.Result;
            earlyColorFormat = colorFormat.Result;
            StateHasChanged();
        }
    }

    // the text of a call's outcome: its value ("done" for a call without one), or the error
    private static async Task<string> OutcomeOf(Func<Task<string>> call)
    {
        try
        {
            return await call();
        }
        catch (Exception exception)
        {
            return ErrorPrefix + exception.Message;
        }
    }

    // two show calls in a row, as a page that opens the select from two places does
    private async Task ShowSelectTwiceAsync()
    {
        await select!.ShowAsync();
        await select!.ShowAsync();
    }
}
