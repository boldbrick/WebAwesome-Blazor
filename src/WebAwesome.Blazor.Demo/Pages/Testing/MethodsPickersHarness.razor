@page "/testing/methods-pickers"

@* e2e harness of the wrapper method suite, group "pickers" (tools\e2e\tests\methods-pickers.spec.js, cases in
   tools\e2e\tests\helpers\method-cases\pickers.js) - deliberately outside /components/; the sweep reaches it through
   the method groups (tools\e2e\data\method-groups.json). Every MethodCall button calls one wrapper method from .NET
   through the wrapper's @ref and shows the outcome. ?early=true also calls methods on the first render, while the
   autoloader still imports the element modules. wa-color-picker, wa-select and wa-time-input are free components;
   wa-date-input and wa-date-picker are Pro components, so their tests skip on the free CDN. *@

<PageTitle>Testing: Methods (pickers)</PageTitle>

<h1>Methods Harness: Pickers</h1>
<p>This page is an end-to-end test harness for the imperative methods of the popup picker wrappers.</p>

<ExampleSection Title="WaColorPicker">
    <div class="method-calls">
        <MethodCall Id="color-focus" Action="() => colorPicker!.FocusAsync()" />
        <MethodCall Id="color-blur" Action="() => colorPicker!.BlurAsync()" />
        <MethodCall Id="color-show" Action="() => colorPicker!.ShowAsync()" />
        <MethodCall Id="color-hide" Action="() => colorPicker!.HideAsync()" />
        <MethodCall Id="color-format-rgb" Function="async () => await colorPicker!.GetFormattedValueAsync(WaColorFormat.Rgb)" />
        <MethodCall Id="color-format-hsl" Function="async () => await colorPicker!.GetFormattedValueAsync(WaColorFormat.Hsl)" />
        <MethodCall Id="color-hex" Function="async () => await colorPicker!.GetHexStringAsync()" />
        <MethodCall Id="color-set-swatches" Action="() => colorPicker!.SetSwatchesAsync(SwatchColors)" />
        <MethodCall Id="color-set-validity" Action="() => colorPicker!.SetCustomValidityAsync(ValidityMessage)" />
        <MethodCall Id="color-reset-validity" Action="() => colorPicker!.ResetValidityAsync()" />
        <MethodCall Id="color-report-validity" Function="async () => await colorPicker!.ReportValidityAsync()" />
    </div>
    <WaColorPicker @ref="colorPicker" data-testid="color-picker" Label="Color" @bind-Value="colorValue" />
</ExampleSection>

<ExampleSection Title="WaSelect">
    <div class="method-calls">
        <MethodCall Id="select-focus" Action="() => select!.FocusAsync()" />
        <MethodCall Id="select-blur" Action="() => select!.BlurAsync()" />
        <MethodCall Id="select-show" Action="() => select!.ShowAsync()" />
        <MethodCall Id="select-hide" Action="() => select!.HideAsync()" />
        <MethodCall Id="select-show-twice" Label="ShowAsync twice" Action="ShowSelectTwiceAsync" />
        <MethodCall Id="select-set-validity" Action="() => select!.SetCustomValidityAsync(ValidityMessage)" />
        <MethodCall Id="select-reset-validity" Action="() => select!.ResetValidityAsync()" />
    </div>
    <WaSelect @ref="select" data-testid="select" Label="Fruit" @bind-Value="selectValue">
        <WaOption Value="apple">Apple</WaOption>
        <WaOption Value="banana">Banana</WaOption>
        <WaOption Value="cherry">Cherry</WaOption>
    </WaSelect>
</ExampleSection>

