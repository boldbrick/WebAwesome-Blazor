<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- multi-targeted library: packed, never published (solution-level dotnet publish would fail with NETSDK1129) -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>WebAwesome.Blazor</PackageId>
    <Title>Web Awesome Blazor Bindings</Title>
    <Description>Strongly-typed Blazor wrappers for the Web Awesome web components: idiomatic C# parameters and enums, EditForm and validation integration, named slots as render fragments, and a minimal JS interop surface. MIT-licensed; the first three version parts are the bound Web Awesome version, a fourth part marks a bindings revision.</Description>
    <Authors>BoldBrick</Authors>
    <PackageTags>blazor;webawesome;web-awesome;shoelace;web-components;components;ui;razor</PackageTags>
    <PackageProjectUrl>https://github.com/boldbrick/WebAwesome-Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/boldbrick/WebAwesome-Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/boldbrick/WebAwesome-Blazor/blob/master/docs/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- deterministic, SourceLink-enabled builds on CI only (local builds run from a PlasticSCM workspace without git metadata) -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- the license notice of the bundled upstream docs ships with the docs bundle only -->
  <ItemGroup Condition="'$(DocPackEnabled)' != 'false'">
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- package docs (DocPack, local Release builds only): the changelog, the technical documentation and the full
       migration chain; docs\contributing (maintainer documentation) and docs\inspector (the WA Inspector tool docs)
       stay out of the package -->
  <ItemGroup>
    <DocPackContent Include="..\..\docs\CHANGELOG.md" Title="Changelog" />
    <DocPackContent Include="..\..\docs\technical" Title="Technical documentation" />
    <DocPackContent Include="..\..\docs\migration" Title="Migration guides" />
  </ItemGroup>

  <!-- the upstream Web Awesome docs (web-awesome/): staged from inputs\WebAwesome with working links -->
  <Import Project="UpstreamDocs.targets" />

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
