@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Web Awesome Blazor Bindings</title>
    <base href="/" />

    <!-- Web Awesome asset tags are emitted by the WebAwesomeAssets component in the shared demo
         App.razor via HeadContent (delivered through the HeadOutlet below), same as the standalone
         WebAssembly host; rendering it here too would duplicate the tags -->

    <link rel="stylesheet" href="css/app.css" />

    <!-- demo-local theming helper shared with the WebAssembly host (served from WebAwesome.Blazor.Demo static assets) -->
    <script src="js/demo-theme.js"></script>

    <!-- demo-local icon mutators referenced by global path from the Icon page (IconLibraryOptions.MutatorFunction) -->
    <script src="js/demo-icons.js"></script>

    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    <WebAwesome.Blazor.Demo.App @rendermode="RenderMode" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // prerendering is off by default, so the server host behaves like the standalone WebAssembly demo: components
    // initialize exactly once, in the interactive circuit. The configuration switch Demo:Prerender (environment
    // variable Demo__Prerender=true) turns it on, so the e2e suite can also run against a prerendered page.
    private const string PrerenderSetting = "Demo:Prerender";

    [Inject] private IConfiguration Configuration { get; set; } = default!;

    private IComponentRenderMode RenderMode => new InteractiveServerRenderMode(prerender: Configuration.GetValue<bool>(PrerenderSetting));
}
